---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import {
  getProducts,
  getCategories,
  type ProductSummary,
  type CategoryListItem,
} from "../lib/api";

export const prerender = false;

const search = Astro.url.searchParams.get("search") ?? undefined;
const categoryParam = Astro.url.searchParams.get("category");
const activeCategory = categoryParam ? Number(categoryParam) : undefined;

let products: ProductSummary[] = [];
let categories: CategoryListItem[] = [];
let loadError = false;
try {
  [products, categories] = await Promise.all([
    getProducts({
      per_page: 12,
      ...(search ? { search } : {}),
      ...(activeCategory ? { category: activeCategory } : {}),
    }),
    getCategories(),
  ]);
} catch {
  loadError = true;
}
---

<Layout>
  <div class="page-header light-section">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <!-- Page Header Box Start -->
          <div class="page-header-box">
            <h1 class="text-anime-style-3" data-cursor="-opaque">
              Our Products
            </h1>
          </div>
          <!-- Page Header Box End -->
        </div>
      </div>
    </div>
  </div>
  <div class="page-products">
    <div class="container">
      <div class="row">
        <div class="col-xl-3 col-lg-4">
          <!-- Page Single Sidebar Start -->
          <div class="page-single-sidebar">
            <!-- Page Category Filter Header Start -->
            <div class="product-category-filter-header wow fadeInUp">
              <div class="product-category-filter-title">
                <img src="/images/icon-filter.svg" alt="" />
                <h2>Filter By</h2>
              </div>
              <div class="product-category-filter-clear-btn">
                <a href="#">Clear All</a>
              </div>
            </div>
            <!-- Page Category Filter Header End -->

            <!-- Product Category Item List Start -->
            <div class="product-category-item-list">
              <!-- Product Category Item Start -->
              <div
                class="product-category-item wow fadeInUp"
                data-wow-delay="0.2s"
              >
                <h2 class="product-category-item-title">Categories</h2>
                <ul>
                  <li class={activeCategory === undefined ? "active" : ""}>
                    <a href="/products">All Products</a>
                  </li>
                  {
                    categories.map((cat) => (
                      <li class={activeCategory === cat.id ? "active" : ""}>
                        <a href={`/products?category=${cat.id}`}>
                          {cat.name} ({cat.count})
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <!-- Product Category Item End -->

              <!-- Product Category Item Start -->
              <!-- <div
                class="product-category-item wow fadeInUp"
                data-wow-delay="0.4s"
              >
                <h2 class="product-category-item-title">Filter by Brands</h2>
                <ul>
                  <li>
                    <input
                      type="checkbox"
                      id="Vaya_Leaf_Organics"
                      name="category"
                      value="Vaya_Leaf_Organics"
                    />
                    <label for="Vaya_Leaf_Organics">Vaya-Leaf Organics</label>
                  </li>
                  <li>
                    <input
                      type="checkbox"
                      id="Herbal_Roots"
                      name="category"
                      value="Herbal_Roots"
                    />
                    <label for="Herbal_Roots">Herbal Roots</label>
                  </li>
                  <li>
                    <input
                      type="checkbox"
                      id="Ayurveda_Pure"
                      name="category"
                      value="Ayurveda_Pure"
                    />
                    <label for="Ayurveda_Pure">Ayurveda Pure</label>
                  </li>
                  <li>
                    <input
                      type="checkbox"
                      id="Botanica_Essentials"
                      name="category"
                      value="Botanica_Essentials"
                    />
                    <label for="Botanica_Essentials">Botanica Essentials</label>
                  </li>
                  <li>
                    <input
                      type="checkbox"
                      id="Natures_Harvest"
                      name="category"
                      value="Natures_Harvest"
                    />
                    <label for="Natures_Harvest">Nature's Harvest</label>
                  </li>
                </ul>
              </div> -->
              <!-- Product Category Item End -->
            </div>
            <!-- Product Category Item List End -->
          </div>
          <!-- Page Single Sidebar End -->
        </div>

        <div class="col-xl-9 col-lg-8">
          <!-- Product item List Box Start -->
          <div class="product-item-list-box">
            <!-- Product Category Filter Header Start -->
            <div class="product-category-filter-header wow fadeInUp">
              <div class="product-category-filter-title">
                <h2>Show All Results</h2>
              </div>
              <div class="product-category-result-info">
                <div class="product-category-result-pagination">
                  <ul>
                    <li><a href="#">1</a></li>
                    <li><a href="#">9</a></li>
                    <li><a href="#">12</a></li>
                    <li><a href="#">15</a></li>
                  </ul>
                </div>
                <div class="product-category-sorting-list">
                  <select
                    name="sorting_list"
                    class="form-control form-select"
                    id="sorting_list"
                    required
                  >
                    <option value="" disabled selected>Default Sorting</option>
                    <option value="Low_to_High">Low to High</option>
                    <option value="High_to_Low">High to Low</option>
                    <option value="Popularity">Popularity</option>
                    <option value="Best_Sellers">Best Sellers</option>
                    <option value="Trending">Trending</option>
                    <option value="Most_Reviewed">Most Reviewed</option>
                  </select>
                </div>
              </div>
            </div>
            <!-- Product Category Filter Header End -->

            <!-- Product item List Start -->
            <div class="product-item-list">
              {
                loadError && (
                  <p>Sorry, products couldn't be loaded right now.</p>
                )
              }
              {!loadError && products.length === 0 && <p>No products found.</p>}
              {products.map((product) => <ProductCard product={product} />)}
            </div>
            <!-- Product item List End -->

            <!-- Product Leader More Button Start -->
            <div
              class="product-learn-more-btn wow fadeInUp"
              data-wow-delay="0.2s"
            >
              <a href="#" class="btn-default">Load More</a>
            </div>
            <!-- Product Leader More Button End -->
          </div>
          <!-- Product item List Box End -->
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .product-category-item ul li a {
    color: #333;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .product-category-item ul li a:hover,
  .product-category-item ul li.active a {
    color: #84c225; /* your brand green — tweak to match exactly */
  }
  .product-category-item ul li.active a {
    font-weight: 700;
  }
</style>
