---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="page-header light-section">
    <div class="container">
      <div class="page-header-box"><h1>Your Cart</h1></div>
    </div>
  </div>

  <div class="page-cart">
    <div class="container">
      <div class="row">
        <div class="col-xl-8">
          <div class="cart-content-box">
            <div class="cart-item-table-box">
              <div class="cart-item-table wow fadeInUp">
                <div class="cart-item-header">
                  <span class="product-header-tag">Product</span>
                  <span class="price-header-tag">Price</span>
                  <span class="quantity-header-tag">Quantity</span>
                  <span class="subtotal-header-tag">Subtotal</span>
                </div>
                <div id="cart-items">Loading your cart…</div>
              </div>
              <div class="cart-item-buttons wow fadeInUp" data-wow-delay="0.2s">
                <a href="/products" class="btn-default btn-update"
                  >Continue Shopping</a
                >
              </div>
            </div>
          </div>
        </div>

        <div class="col-xl-4">
          <div class="page-single-sidebar right-side-sidebar">
            <div class="order-summary-box wow fadeInUp" data-wow-delay="0.2s">
              <div class="order-summary-content-box">
                <div class="order-summary-box-title">
                  <h2>Order Summary</h2>
                </div>
                <div class="order-summary-total">
                  <h3>Subtotal</h3>
                  <h3 id="cart-subtotal">₹0</h3>
                </div>
                <p class="order-summary-note">
                  Shipping &amp; taxes are calculated at checkout.
                </p>
              </div>
              <div class="order-checkout-button">
                <a href="#" id="checkoutBtn" class="btn-default"
                  >Proceed to Checkout</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .cart-remove-hit {
    position: absolute;
    top: -5px;
    right: -5px;
    width: 18px;
    height: 18px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    z-index: 2;
  }
  .cart-empty {
    padding: 48px 0;
    text-align: center;
    color: #555;
  }
  .cart-empty p {
    margin-bottom: 16px;
    font-size: 16px;
  }
  .order-summary-note {
    font-size: 13px;
    color: #7a7a7a;
    margin-top: 6px;
  }
</style>

<script>
  import {
    getCart,
    updateCartItem,
    removeCartItem,
    clearCart,
    checkout,
  } from "../lib/cart";

  const itemsEl = document.getElementById("cart-items");
  const subtotalEl = document.getElementById("cart-subtotal");

  function money(currency: string, amount: string) {
    const symbol = currency === "INR" ? "₹" : currency + " ";
    return `${symbol}${amount}`;
  }

  function rowHtml(it: any, currency: string) {
    return `
      <div class="cart-item" data-id="${it.product_id}" data-qty="${it.quantity}">
        <div class="cart-item-image-content">
                    <div class="cart-item-image"><figure><img src="${it.image?.src ?? "/images/product-1-img.png"}" alt="${it.name}"></figure><button type="button" class="cart-remove-hit" data-action="remove" aria-label="Remove item"></button></div>
          <div class="cart-item-info-content">
            <div class="cart-item-title"><p>${it.name}</p></div>
            <div class="cart-item-price"><p>${money(currency, it.price)}</p></div>
          </div>
        </div>
        <div class="cart-item-quantity-total">
          <div class="cart-item-quantity">
            <div class="qty-box">
              <button type="button" class="qty-btn minus" data-action="dec"><span>-</span></button>
              <input type="text" class="qty-input" value="${it.quantity}" readonly>
              <button type="button" class="qty-btn plus" data-action="inc"><span>+</span></button>
            </div>
          </div>
          <div class="cart-item-subtotal"><p>${money(currency, it.line_total)}</p></div>
        </div>
                
      </div>`;
  }

  function render(cart: any) {
    if (!itemsEl || !subtotalEl) return;
    if (!cart.items.length) {
      itemsEl.innerHTML = `<div class="cart-empty"><p>Your cart is empty.</p><a class="btn-default" href="/products">Browse products</a></div>`;
    } else {
      itemsEl.innerHTML = cart.items
        .map((it: any) => rowHtml(it, cart.currency))
        .join("");
    }
    subtotalEl.textContent = money(cart.currency, cart.subtotal);
    window.dispatchEvent(new CustomEvent("cart:updated"));
  }

  async function load() {
    try {
      render(await getCart());
    } catch {
      if (itemsEl)
        itemsEl.innerHTML = `<p>Couldn't load your cart. Please try again.</p>`;
    }
  }

  document.addEventListener("click", async (e) => {
    const el = (e.target as HTMLElement).closest(
      "[data-action]",
    ) as HTMLElement | null;

    // Clear cart
    if ((e.target as HTMLElement).closest("#clearCartBtn")) {
      e.preventDefault();
      try {
        render(await clearCart());
      } catch {
        /* ignore */
      }
      return;
    }

    // Proceed to checkout → hand off to WooCommerce native checkout
    const checkoutBtn = (e.target as HTMLElement).closest(
      "#checkoutBtn",
    ) as HTMLAnchorElement | null;
    if (checkoutBtn) {
      e.preventDefault();
      checkoutBtn.style.pointerEvents = "none";
      const original = checkoutBtn.textContent;
      checkoutBtn.textContent = "Redirecting…";
      try {
        window.location.href = await checkout();
      } catch {
        checkoutBtn.style.pointerEvents = "";
        checkoutBtn.textContent = original;
        if (subtotalEl)
          subtotalEl.insertAdjacentHTML(
            "afterend",
            `<p class="order-summary-note" style="color:#c0392b">Couldn't start checkout — your cart may be empty.</p>`,
          );
      }
      return;
    }
    if (!el) return;

    const row = el.closest(".cart-item") as HTMLElement | null;
    if (!row) return;
    const id = Number(row.dataset.id);
    const qty = Number(row.dataset.qty || "1");
    const action = el.dataset.action;
    try {
      let cart;
      if (action === "inc") cart = await updateCartItem(id, qty + 1);
      else if (action === "dec")
        cart =
          qty > 1
            ? await updateCartItem(id, qty - 1)
            : await removeCartItem(id);
      else if (action === "remove") cart = await removeCartItem(id);
      if (cart) render(cart);
    } catch {
      /* ignore */
    }
  });

  load();
</script>
