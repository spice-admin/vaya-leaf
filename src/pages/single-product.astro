---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getProduct, getProducts } from "../lib/api";

export const prerender = false;

const slug = Astro.url.searchParams.get("slug");
if (!slug) return Astro.redirect("/products");

let product;
try {
  product = await getProduct(slug);
} catch {
  product = null;
}
if (!product) return Astro.redirect("/products");

const category = product.categories[0]?.name ?? "";
const symbol = product.currency === "INR" ? "₹" : `${product.currency} `;
const showSale = product.on_sale && product.sale_price !== "";
const tagNames = product.tags.map((tag) => tag.name).join(", ");
const related = (await getProducts({ per_page: 5 }))
  .filter((p) => p.slug !== product.slug)
  .slice(0, 4);
---

<Layout>
  <!-- Page Product Single Start -->
  <div class="page-product-single">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <!-- Page Product Single Content Start -->
          <div class="page-product-single-content">
            <!-- Product Single Breadcrumb List Start -->
            <div class="product-single-breadcrumb-list">
              <nav class="wow fadeInUp">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                  <li class="breadcrumb-item">
                    <a href="products.html">Categories</a>
                  </li>
                  <li class="breadcrumb-item">
                    <a href="products.html">{category}</a>
                  </li>
                  <li class="breadcrumb-item active" aria-current="page">
                    {product.name}
                  </li>
                </ol>
              </nav>
            </div>
            <!-- Product Single Breadcrumb List End -->

            <!-- Product Single Info Box Start -->
            <div class="product-single-info-box">
              <!-- Product Single Image Box Start -->
              <div class="product-single-image-box wow fadeInUp">
                <!-- Product Single Image Slider Start -->
                <div class="swiper product-single-image-slider">
                  <div class="swiper-wrapper">
                    {product.images.map((img) => (
                      <div class="swiper-slide">
                        <figure><img src={img.src} alt={img.alt || product.name} /></figure>
                      </div>
                    ))}
                  </div>
                </div>
                <!-- Product Single Image Slider End -->

                <!-- Product Single Image Item Start -->
                <div class="swiper product-single-image-item">
                  <div class="swiper-wrapper">
                    {product.images.map((img) => (
                      <div class="swiper-slide">
                        <figure class="imgae-anime"><img src={img.src} alt={img.alt || product.name} /></figure>
                      </div>
                    ))}
                  </div>
                </div>
                <!-- Product Single Image Item End -->
              </div>
              <!-- Product Single Image Box End -->

              <!-- Product Single Info Content Start -->
              <div class="product-single-info-content">
                <!-- Product Single title Start -->
                <div class="product-single-title wow fadeInUp">
                  <span>{category}</span>
                  <h1>{product.name}</h1>
                </div>
                <!-- Product Single title End -->

                <!-- Product Single Rating Start -->
                <div class="product-single-rating wow fadeInUp">
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <b>({product.rating_count} Reviews)</b>
                </div>
                <!-- Product Single Rating End -->

                <!-- Product Single Price Start -->
                <div class="product-single-price wow fadeInUp" data-wow-delay="0.2s">
                  {showSale
                    ? <h2>{symbol}{product.sale_price} <sub>{symbol}{product.regular_price}</sub></h2>
                    : <h2>{symbol}{product.price}</h2>}
                </div>
                <!-- Product Single Price End -->

                <!-- Product Single Description Start -->
                <div class="product-single-description wow fadeInUp" data-wow-delay="0.2s">
                  <p set:html={product.short_description}></p>
                </div>
                <!-- Product Single Description End -->

                <!-- Product Single Item Weight Start -->
                <div
                  class="product-single-item-weight wow fadeInUp"
                  data-wow-delay="0.4s"
                >
                  <h2>Weight</h2>
                  <ul>
                    <li>
                      <input
                        type="radio"
                        id="500g"
                        name="Size"
                        value="500g"
                        checked
                      /><label for="500g">500g</label>
                    </li>
                    <li>
                      <input
                        type="radio"
                        id="1kg"
                        name="Size"
                        value="1kg"
                      /><label for="1kg">1 Kg</label>
                    </li>
                    <li>
                      <input
                        type="radio"
                        id="2kg"
                        name="Size"
                        value="2kg"
                      /><label for="2kg">2 kg</label>
                    </li>
                    <li>
                      <input
                        type="radio"
                        id="5kg"
                        name="Size"
                        value="5kg"
                      /><label for="5kg">5 kg</label>
                    </li>
                  </ul>
                </div>
                <!-- Product Single Item Weight End -->

                <!-- Product Single Content Body Start -->
                <div
                  class="product-single-content-body wow fadeInUp"
                  data-wow-delay="0.4s"
                >
                  <div class="qty-box">
                    <button class="qty-btn minus"><span>-</span></button>
                    <input type="text" class="qty-input" value="01" readonly />
                    <button class="qty-btn plus"><span>+</span></button>
                  </div>

                  <div class="product-single-content-btn">
                    <a href="cart.html" class="btn-default">Add To cart</a>
                  </div>

                  <div class="product-single-action">
                    <ul>
                      <li>
                        <a href="account-wishlist.html"
                          ><img
                            src="images/icon-wishlist-primary.svg"
                            alt=""
                          /></a
                        >
                      </li>
                    </ul>
                  </div>
                </div>
                <!-- Product Single Content Body End -->

                <!-- Product Single Content Footer Start -->
                <div
                  class="product-single-content-footer wow fadeInUp"
                  data-wow-delay="0.6s"
                >
                  <!-- Product Single Details Start -->
                  <div class="product-single-details-list">
                    <ul>
                      <li><span>SKU:</span> {product.sku}</li>
                      <li><span>Tags:</span> {tagNames}</li>
                    </ul>
                  </div>
                  <!-- Product Single Details End -->
                </div>
                <!-- Product Single Content Footer End -->
              </div>
              <!-- Product Single Info Content End -->
            </div>
            <!-- Product Single Info Box End -->

            <!-- Product Single Info Start -->
            <div
              class="product-single-review-box wow fadeInUp"
              data-wow-delay="0.25s"
            >
              <!-- Product Single Box Start -->
              <div
                class="product-single-review-tab tab-content"
                id="missionvision"
              >
                <!-- Product Step Nav start -->
                <div class="product-step-nav">
                  <ul class="nav nav-tabs" id="mvTab" role="tablist">
                    <li class="nav-item" role="presentation">
                      <button
                        class="nav-link active"
                        id="first-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#first"
                        type="button"
                        role="tab"
                        aria-controls="first"
                        aria-selected="true">Product Description</button
                      >
                    </li>
                    <li class="nav-item" role="presentation">
                      <button
                        class="nav-link"
                        id="second-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#second"
                        type="button"
                        role="tab"
                        aria-controls="second"
                        aria-selected="false">Additional Information</button
                      >
                    </li>
                    <li class="nav-item" role="presentation">
                      <button
                        class="nav-link"
                        id="third-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#third"
                        type="button"
                        role="tab"
                        aria-controls="third"
                        aria-selected="false">Reviews (50)</button
                      >
                    </li>
                  </ul>
                </div>
                <!-- Product Step Nav End -->

                <!-- Product Tab Item Box Start -->
                <div
                  class="product-tab-item-box tab-pane fade show active"
                  id="first"
                  role="tabpanel"
                >
                  <div class="product-tab-item-content" set:html={product.description}></div>
                </div>
                <!-- Product Tab Item End -->

                <!-- Product Tab Item Box Start -->
                <div
                  class="product-tab-item-box tab-pane fade"
                  id="second"
                  role="tabpanel"
                >
                  <div class="product-additional-content">
                    <!-- Product Additional Content Title Start -->
                    <div class="product-additional-content-title">
                      <h2>Additional Information</h2>
                    </div>
                    <!-- Product Additional Content Title End -->

                    <!-- Product Additional Info Table Start -->
                    <div class="product-additional-info-table">
                      <table>
                        <tr>
                          <td><b>Type</b></td>
                          <td>Red Delicious</td>
                        </tr>
                        <tr>
                          <td><b>Best Before</b></td>
                          <td>5 Day</td>
                        </tr>

                        <tr>
                          <td><b>Usage</b></td>
                          <td>Juices, Smoothies, Salads</td>
                        </tr>
                      </table>
                    </div>
                    <!-- Product Additional Info Table End -->
                  </div>
                </div>
                <!-- Product Tab Item Box End -->

                <!-- Product Tab Item Box Start -->
                <div
                  class="product-tab-item-box tab-pane fade"
                  id="third"
                  role="tabpanel"
                >
                  <div class="product-review-from-content">
                    <!-- Customer Review List Start -->
                    <div class="customer-review-list">
                      <!-- Customer Review Item Start -->
                      <div class="customer-review-item">
                        <div class="icon-box">
                          <img src="images/author-1.jpg" alt="" />
                        </div>
                        <div class="customer-review-item-body">
                          <div class="customer-review-item-content">
                            <p><span>Author</span> - May 18, 2026</p>
                            <p>
                              their explosive crunch, perfect balance of
                              sweetness and tartness
                            </p>
                          </div>
                          <div class="customer-review-item-rating">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                          </div>
                        </div>
                      </div>
                      <!-- Customer Review Item End -->

                      <!-- Customer Review Item Start -->
                      <div class="customer-review-item">
                        <div class="icon-box">
                          <img src="images/author-2.jpg" alt="" />
                        </div>
                        <div class="customer-review-item-body">
                          <div class="customer-review-item-content">
                            <p>Author - May 10, 2026</p>
                            <p>
                              Best eaten fresh and whole instead of juice for
                              maximum health benefits
                            </p>
                          </div>
                          <div class="customer-review-item-rating">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                          </div>
                        </div>
                      </div>
                      <!-- Customer Review Item End -->
                    </div>
                    <!-- Customer Review List End -->

                    <!-- Contact Form Start -->
                    <div class="review-form">
                      <div class="review-form-content">
                        <h3>Add a review</h3>
                        <p>
                          Your email address will not be published. Required
                          fields are marked Your rating
                        </p>
                      </div>
                      <form
                        id="reviewForm"
                        action="#"
                        method="POST"
                        data-toggle="validator"
                      >
                        <div class="row">
                          <div class="form-group col-md-12 mb-4">
                            <input
                              type="text"
                              name="review"
                              class="form-control"
                              id="review"
                              placeholder="Your review"
                              required
                            />
                            <div class="help-block with-errors"></div>
                          </div>

                          <div class="form-group col-md-6 mb-4">
                            <input
                              type="text"
                              name="name"
                              class="form-control"
                              id="name"
                              placeholder="Full Name"
                              required
                            />
                            <div class="help-block with-errors"></div>
                          </div>

                          <div class="form-group col-md-6 mb-4">
                            <input
                              type="email"
                              name="email"
                              class="form-control"
                              id="email"
                              placeholder="Email"
                              required
                            />
                            <div class="help-block with-errors"></div>
                          </div>

                          <div class="form-group review-form-note">
                            <input type="checkbox" id="#" name="#" />
                            <label class="form-label"
                              >Save my name, email, and website in this browser
                              for the next time I comment.</label
                            >
                          </div>

                          <div class="col-md-12">
                            <button type="submit" class="btn-default"
                              >Submit Message</button
                            >
                            <div id="msgSubmit" class="h3 hidden"></div>
                          </div>
                        </div>
                      </form>
                    </div>
                    <!-- Contact Form End -->
                  </div>
                </div>
                <!-- Product Tab Item Box End -->
              </div>
              <!-- Product Single Box End -->
            </div>
            <!-- Product Single Info End -->
          </div>
          <!-- Page Product Single Content End -->
        </div>
      </div>
    </div>
  </div>
  <!-- Page Products Single End -->

  <!-- Related Products Section Start -->
  <div class="related-products light-section">
    <div class="container">
      <div class="row section-row">
        <div class="col-lg-12">
          <!-- Section Title Start -->
          <div class="section-title section-title-center">
            <span class="section-sub-title wow fadeInUp">You May Like</span>
            <h2 class="text-anime-style-3" data-cursor="-opaque">
              Related Fresh Grocery Products
            </h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s">
              Discover more fresh and healthy grocery products carefully
              selected to complement your everyday shopping needs.
            </p>
          </div>
          <!-- Section Title End -->
        </div>
      </div>

      <div class="row">
        <div class="col-xl-12">
          <!-- Related Product Item List Start -->
          <div class="related-product-items-list">
            {related.map((p) => <ProductCard product={p} />)}
          </div>
          <!-- Related Product Item List End -->
        </div>
      </div>
    </div>
  </div>
  <!-- Related Products Section End -->
</Layout>
