---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="page-header light-section">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <!-- Page Header Box Start -->
          <div class="page-header-box">
            <h1 class="text-anime-style-3" data-cursor="-opaque">Our Blog</h1>
          </div>
          <!-- Page Header Box End -->
        </div>
      </div>
    </div>
  </div>

  <div class="page-blog">
    <div class="container">
      <div class="row">
        <div class="col-xl-4 col-md-6">
          <!-- Post Item Start -->
          <div class="post-item wow fadeInUp">
            <div class="post-featured-image">
              <a href="#" data-cursor-text="View">
                <figure class="image-anime">
                  <img src="/images/post-1.jpg" alt="" />
                </figure>
              </a>
            </div>
            <div class="post-item-body">
              <div class="post-item-meta">
                <ul>
                  <li>
                    <img src="/images/icon-calendar-primary.svg" alt="" />May
                    18, 2026
                  </li>
                  <li>
                    <img src="/images/icon-tag.svg" alt="" /><a href="#">Food</a
                    >
                  </li>
                </ul>
              </div>
              <div class="post-item-content">
                <h2>
                  <a href="#">Fresh Picks For Healthy Living</a>
                </h2>
                <p>
                  Discover how choosing fresh fruits vegetables can improve your
                  meals lifestyle effortlessly.
                </p>
              </div>
              <div class="post-item-btn">
                <a href="#" class="readmore-btn">Read More</a>
              </div>
            </div>
          </div>
          <!-- Post Item End -->
        </div>

        <div class="col-xl-4 col-md-6">
          <!-- Post Item Start -->
          <div class="post-item wow fadeInUp" data-wow-delay="0.2s">
            <div class="post-featured-image">
              <a href="#" data-cursor-text="View">
                <figure class="image-anime">
                  <img src="/images/post-2.jpg" alt="" />
                </figure>
              </a>
            </div>
            <div class="post-item-body">
              <div class="post-item-meta">
                <ul>
                  <li>
                    <img src="/images/icon-calendar-primary.svg" alt="" />May
                    10, 2026
                  </li>
                  <li>
                    <img src="/images/icon-tag.svg" alt="" /><a href="#">Food</a
                    >
                  </li>
                </ul>
              </div>
              <div class="post-item-content">
                <h2>
                  <a href="#">Fresh Picks For Healthy Living</a>
                </h2>
                <p>
                  Learn simple and effective ways to save money, reduce waste,
                  and shop smarter.
                </p>
              </div>
              <div class="post-item-btn">
                <a href="#" class="readmore-btn">Read More</a>
              </div>
            </div>
          </div>
          <!-- Post Item End -->
        </div>

        <div class="col-xl-4 col-md-6">
          <!-- Post Item Start -->
          <div class="post-item wow fadeInUp" data-wow-delay="0.4s">
            <div class="post-featured-image">
              <a href="#" data-cursor-text="View">
                <figure class="image-anime">
                  <img src="/images/post-3.jpg" alt="" />
                </figure>
              </a>
            </div>
            <div class="post-item-body">
              <div class="post-item-meta">
                <ul>
                  <li>
                    <img src="/images/icon-calendar-primary.svg" alt="" />May
                    02, 2026
                  </li>
                  <li>
                    <img src="/images/icon-tag.svg" alt="" /><a href="#">Food</a
                    >
                  </li>
                </ul>
              </div>
              <div class="post-item-content">
                <h2>
                  <a href="#">Benefits Of Organic Foods</a>
                </h2>
                <p>
                  Explore why organic products are better for your health
                  sustainable environment.
                </p>
              </div>
              <div class="post-item-btn">
                <a href="#" class="readmore-btn">Read More</a>
              </div>
            </div>
          </div>
          <!-- Post Item End -->
        </div>

        <div class="col-lg-12">
          <!-- Page Pagination Start -->
          <div class="page-pagination wow fadeInUp" data-wow-delay="0.4s">
            <ul class="pagination">
              <li><a href="#"><i class="fa-solid fa-angle-left"></i></a></li>
              <li class="active"><a href="#">1</a></li>
              <li><a href="#">2</a></li>
              <li><a href="#">3</a></li>
              <li><a href="#"><i class="fa-solid fa-angle-right"></i></a></li>
            </ul>
          </div>
          <!-- Page Pagination End -->
        </div>
      </div>
    </div>
  </div>
</Layout>
