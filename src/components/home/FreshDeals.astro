---

---

<div class="our-fresh-deals">
  <div class="container">
    <div class="row">
      <div class="col-xl-12">
        <!-- Fresh Deals Box Start -->
        <div class="fresh-deals-box">
          <!-- Fresh Deals Image Start -->
          <div class="fresh-deals-image">
            <figure>
              <img
                src="/images/fresh-deals-image-1.png"
                alt="Natural herbal wellness products deal"
              />
            </figure>
          </div>
          <!-- Fresh Deals Image End -->

          <!-- Fresh Deals Content Start -->
          <div class="fresh-deals-content">
            <!-- Section Title Start -->
            <div class="section-title">
              <span class="section-sub-title wow fadeInUp"
                >Save up to 30% off</span
              >
              <h2 class="text-anime-style-3" data-cursor="-opaque">
                Natural Deals Everyday
              </h2>
              <p class="wow fadeInUp" data-wow-delay="0.2s">
                Enjoy great savings on pure herbal remedies, organic wellness
                blends, natural supplements, and daily self-care essentials with
                new deals and special discounts added daily just for you.
              </p>
            </div>
            <!-- Section Title End -->

            <!-- Fresh Deals Body List Start -->
            <div
              class="fresh-deals-body-list wow fadeInUp"
              data-wow-delay="0.4s"
            >
              <ul>
                <li>100% Natural</li>
                <li>Honest Pricing</li>
                <li>Daily Wellness</li>
              </ul>
            </div>
            <!-- Fresh Deals Body List End -->

            <!-- Fresh Deals Footer Start -->
            <div class="fresh-deals-footer wow fadeInUp" data-wow-delay="0.6s">
              <!-- Fresh Deals Button Start -->
              <div class="fresh-deals-btn">
                <a href="/products" class="btn-default">Shop now</a>
              </div>
              <!-- Fresh Deals Button End -->

              <!-- Deals Free Delivery item Start -->
              <div class="deals-free-delivery-item">
                <p>
                  <img
                    src="/images/icon-truck-primary.svg"
                    alt="Delivery truck icon"
                  />Free delivery over <span>₹2,999</span>
                </p>
              </div>
              <!-- Deals Free Delivery item End -->
            </div>
            <!-- Fresh Deals Footer End -->
          </div>
          <!-- Fresh Deals Content End -->
        </div>
        <!-- Fresh Deals Box End -->
      </div>
    </div>
  </div>
</div>
