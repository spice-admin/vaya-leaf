<div class="our-fresh-stories">
  <div class="container">
    <div class="row section-row">
      <div class="col-lg-12">
        <!-- Section Title Start -->
        <div class="section-title section-title-center">
          <span class="section-sub-title wow fadeInUp">Wellness Stories</span>
          <h2 class="text-anime-style-3" data-cursor="-opaque">
            Pure Nature In Every Step
          </h2>
          <p class="wow fadeInUp" data-wow-delay="0.2s">
            Discover inspiring stories behind ancient herbal wisdom, holistic
            living tips, and everyday rituals that celebrate nature, purity, and
            well-being.
          </p>
        </div>
        <!-- Section Title End -->
      </div>
    </div>

