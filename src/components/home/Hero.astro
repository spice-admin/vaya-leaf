<!--Chnage Color Combinations --><!-- Instead of Images keep hero section dynamic and add slider -->
<div class="hero light-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-xl-6">
        <!-- Hero Content Start -->
        <div class="hero-content">
          <!-- Section Title Start -->
          <div class="section-title">
            <span class="section-sub-title wow fadeInUp">Nature's Goodness</span
            >
            <h1 class="text-anime-style-3" data-cursor="-opaque">
              Handpicked Herbs for Your Everyday Wellness Ritual
            </h1>
            <p class="wow fadeInUp" data-wow-delay="0.2s">
              Explore nature’s finest herbal formulations, organic botanicals,
              daily wellness must-haves, natural supplements, and Ayurvedic
              healing products — delivered to your doorstep with guaranteed
              purity for your family's holistic well-being.
            </p>
          </div>
          <!-- Section Title End -->

          <!-- Hero Button Start -->
          <div class="hero-btn wow fadeInUp" data-wow-delay="0.4s">
            <a href="/products" class="btn-default">Shop Now</a>
          </div>
          <!-- Hero Button End -->
        </div>
        <!-- Hero Content End -->
      </div>

      <div class="col-xl-6">
        <!-- Hero Image Start -->
        <div class="hero-image wow fadeInUp" data-wow-delay="0.2s">
          <figure>
            <img src="/images/hero-img-1.png" alt="" />
          </figure>
        </div>
        <!-- Hero Image End -->
      </div>
    </div>
  </div>
</div>
