---
import ProductCard from "../ProductCard.astro";
import { getProducts, type ProductSummary } from "../../lib/api";

let products: ProductSummary[] = [];
try {
  products = await getProducts({ per_page: 8 });
} catch {
  products = [];
}
---

<div class="our-products">
  <div class="container">
    <div class="row section-row align-items-end">
      <div class="col-xl-6">
        <!-- Section Title Start -->
        <div class="section-title">
          <span class="section-sub-title wow fadeInUp">Featured Products</span>
          <h2 class="text-anime-style-3" data-cursor="-opaque">
            Handpicked Herbal Remedies at The Best Prices
          </h2>
        </div>
        <!-- Section Title End -->
      </div>

      <div class="col-xl-6">
        <!-- Section Content Btn Start -->
        <div class="section-content-btn">
          <!-- Section Title Content Start -->
          <div class="section-title-content wow fadeInUp" data-wow-delay="0.2s">
            <p>
              Discover our curated selection of pure, high-quality herbal
              products offered at honest prices for your daily wellness journey.
            </p>
          </div>
          <!-- Section Title Content End -->

          <!-- Section Button Start -->
          <div class="section-btn wow fadeInUp" data-wow-delay="0.4s">
            <a class="btn-default" href="/products">View All Products</a>
          </div>
          <!-- Section Button End -->
        </div>
        <!-- Section Content Btn End -->
      </div>
    </div>

    <div class="row">
      <div class="col-xl-12">
        <!-- Product Slider Start -->
        <div class="product-slider">
          <div class="swiper">
            <div class="swiper-wrapper">
              {
                products.map((product) => (
                  <div class="swiper-slide">
                    <ProductCard product={product} />
                  </div>
                ))
              }
            </div>
            <div class="product-pagination"></div>
          </div>
        </div>
        <!-- Product Slider End -->
      </div>

      <div class="col-lg-12">
        <!-- Section Footer Text Start -->
        <div
          class="section-footer-text section-satisfy-img wow fadeInUp"
          data-wow-delay="0.2s"
        >
          <!-- Satisfy Client Images Start -->
          <div class="satisfy-client-images">
            <div class="satisfy-client-image">
              <figure class="image-anime">
                <img src="/images/author-1.jpg" alt="Happy customer" />
              </figure>
            </div>
            <div class="satisfy-client-image add-more">
              <img src="/images/icon-phone-white.svg" alt="Call us" />
            </div>
          </div>
          <!-- Satisfy Client Images End -->
          <p>
            Need guidance on choosing the right herbs? <a href="contact.html"
              >Get Free Ayurvedic Consultation</a
            >
          </p>
        </div>
        <!-- Section Footer Text End -->
      </div>
    </div>
  </div>
</div>
