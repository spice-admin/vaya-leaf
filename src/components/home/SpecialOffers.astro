<div class="special-offers">
  <div class="container">
    <div class="row">
      <div class="col-xl-12">
        <!-- Special Offer Item Box Start -->
        <div class="special-offers-item-list">
          <!-- Special Offer Item Start -->
          <div class="special-offer-item wow fadeInUp">
            <div class="special-offer-item-body">
              <div class="special-offer-item-content">
                <span class="special-offer-item-title">Limited Offer</span>
                <h2>Pure Herbs At Best Prices</h2>
              </div>
              <div class="special-offer-item-btn">
                <a href="#">Up To 30% Off</a>
              </div>
            </div>
            <div class="special-offer-item-image">
              <figure>
                <img
                  src="/images/special-off-img-1.png"
                  alt="Pure herbal products on limited offer"
                />
              </figure>
            </div>
          </div>
          <!-- Special Offer Item End -->

          <!-- Special Offer Item Start -->
          <div
            class="special-offer-item box-2 wow fadeInUp"
            data-wow-delay="0.2s"
          >
            <div class="special-offer-item-body">
              <div class="special-offer-item-content">
                <span class="special-offer-item-title">Special Deal</span>
                <h2>Buy More Save On Wellness Daily</h2>
              </div>
              <div class="special-offer-item-btn">
                <a href="#">Buy 2 Get 1 Free</a>
              </div>
            </div>
            <div class="special-offer-item-image">
              <figure>
                <img
                  src="/images/special-off-img-2.png"
                  alt="Daily wellness herbal products special deal"
                />
              </figure>
            </div>
          </div>
          <!-- Special Offer Item End -->

          <!-- Special Offer Item Start -->
          <div
            class="special-offer-item box-3 wow fadeInUp"
            data-wow-delay="0.4s"
          >
            <div class="special-offer-item-body">
              <div class="special-offer-item-content">
                <span class="special-offer-item-title">Today Only</span>
                <h2>Save Big On Daily Wellness Today</h2>
              </div>
              <div class="special-offer-item-btn">
                <a href="#">Flat 25% Off</a>
              </div>
            </div>
            <div class="special-offer-item-image">
              <figure>
                <img
                  src="/images/special-off-img-3.png"
                  alt="Daily wellness essentials discount today only"
                />
              </figure>
            </div>
          </div>
          <!-- Special Offer Item End -->
        </div>
        <!-- Special Offer Item Box End -->
      </div>
    </div>
  </div>
</div>
