<div class="our-exclusive-deals">
  <div class="container">
    <div class="row">
      <div class="col-xl-12">
        <!-- Exclusive Deals Box Start -->
        <div class="exclusive-deals-box">
          <!-- Exclusive Deals Image Start -->
          <div class="exclusive-deals-image wow fadeInUp">
            <figure>
              <img src="/images/exclusive-img-1.png" alt="" />
            </figure>
          </div>
          <!-- Exclusive Deals Image End -->

          <!-- exclusive Deals Content Start -->
          <div class="exclusive-deals-content">
            <!-- Section Title Start -->
            <div class="section-title">
              <span class="section-sub-title wow fadeInUp">exclusive deals</span
              >
              <h2 class="text-anime-style-3" data-cursor="-opaque">
                Exclusive Member Savings
              </h2>
              <p class="wow fadeInUp" data-wow-delay="0.2s">
                Join our newsletter to receive updates on fresh products,
                exclusive offers, and exciting deals delivered straight to your
                inbox.
              </p>
            </div>
            <!-- Section Title End -->

            <!-- Exclusive Deal Form Start -->
            <div class="exclusive-deal-form wow fadeInUp" data-wow-delay="0.4s">
              <form id="ExclusiveDealForm" action="#" method="POST">
                <div class="form-group">
                  <input
                    type="email"
                    name="mail"
                    class="form-control"
                    id="e-mail"
                    placeholder="Enter Email Address*"
                    required
                  />
                  <button type="submit" class="newsletter-btn"
                    ><img src="/images/arrow-white.svg" alt="" /></button
                  >
                </div>
              </form>
            </div>
            <!-- Exclusive Deal Form End -->
          </div>
          <!-- Exclusive Deals Content End -->
        </div>
        <!-- Exclusive Deals Box End -->
      </div>
    </div>
  </div>
</div>
