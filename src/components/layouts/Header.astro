<style>
  .header-cart-link {
    position: relative;
    display: inline-block;
  }
  .header-cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: #b3c748;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
  }
</style>

<script>
  import { getCart } from "../../lib/cart";

  const badge = document.getElementById("headerCartCount");

  function update(count: number) {
    if (!badge) return;
    badge.textContent = String(count);
    badge.hidden = count <= 0;
  }

  async function refresh() {
    try {
      const cart = await getCart();
      update(cart.total_items || 0);
    } catch {
      update(0);
    }
  }

  window.addEventListener("cart:updated", refresh);
  refresh();
</script>
