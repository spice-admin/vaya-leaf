---

---

<div class="our-faqs light-section">
  <div class="container">
    <div class="row">
      <div class="col-xl-6">
        <!-- Faqs Content Start -->
        <div class="faqs-content">
          <!-- Section Title Start -->
          <div class="section-title section-title-center">
            <span class="section-sub-title wow fadeInUp"
              >Frequently Asked Questions</span
            >
            <h2 class="text-anime-style-3" data-cursor="-opaque">
              Wellness Support Questions
            </h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s">
              Find answers to common questions about herbal product purity,
              Ayurvedic authenticity, online orders, delivery, and personalized
              wellness guidance.
            </p>
          </div>
          <!-- Section Title End -->

          <!-- FAQ CTA Box Start -->
          <div class="faq-cta-box wow fadeInUp" data-wow-delay="0.4s">
            <div class="satisfy-client-images">
              <div class="satisfy-client-image">
                <figure class="image-anime">
                  <img
                    src="images/author-1.jpg"
                    alt="Happy wellness customer"
                  />
                </figure>
              </div>
              <div class="satisfy-client-image">
                <figure class="image-anime">
                  <img
                    src="images/author-2.jpg"
                    alt="Satisfied herbal product user"
                  />
                </figure>
              </div>
              <div class="satisfy-client-image">
                <figure class="image-anime">
                  <img
                    src="images/author-3.jpg"
                    alt="Natural wellness advocate"
                  />
                </figure>
              </div>
              <div class="satisfy-client-image add-more">
                <h2><span class="counter">5</span>K+</h2>
              </div>
            </div>
            <div class="faq-cta-content">
              <h3>Still have any questions?</h3>
              <p>
                Our wellness experts are ready to guide you on your herbal
                journey.
              </p>
            </div>
            <div class="faq-cta-btn">
              <a href="contact.html" class="btn-default">Contact Us Now</a>
            </div>
          </div>
          <!-- FAQ CTA Box End -->
        </div>
        <!-- Faqs Content End -->
      </div>

      <div class="col-xl-6">
        <!-- FAQ Accordion Start -->
        <div class="faq-accordion" id="accordion">
          <!-- FAQ Item Start -->
          <div class="accordion-item wow fadeInUp">
            <h2 class="accordion-header" id="heading1">
              <button
                class="accordion-button"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse1"
                aria-expanded="true"
                aria-controls="collapse1"
              >
                Do you offer same-day delivery for herbal products?
              </button>
            </h2>
            <div
              id="collapse1"
              class="accordion-collapse collapse show"
              role="region"
              aria-labelledby="heading1"
              data-bs-parent="#accordion"
            >
              <div class="accordion-body">
                <p>
                  Yes, we offer same-day delivery for herbal and wellness
                  products in select cities across India for orders placed
                  before 2 PM. For other locations, we ensure delivery within
                  2–3 business days, with all products carefully packed to
                  preserve their natural potency and freshness.
                </p>
              </div>
            </div>
          </div>
          <!-- FAQ Item End -->

          <!-- FAQ Item Start -->
          <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
            <h2 class="accordion-header" id="heading2">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse2"
                aria-expanded="false"
                aria-controls="collapse2"
              >
                Are your herbal products 100% pure and authentic?
              </button>
            </h2>
            <div
              id="collapse2"
              class="accordion-collapse collapse"
              role="region"
              aria-labelledby="heading2"
              data-bs-parent="#accordion"
            >
              <div class="accordion-body">
                <p>
                  Absolutely. Every product at Vaya-Leaf undergoes rigorous lab
                  testing for purity, potency, and the absence of harmful
                  additives. We source directly from certified organic farms and
                  traditional Ayurvedic growers, ensuring you receive only
                  genuine, unadulterated botanicals.
                </p>
              </div>
            </div>
          </div>
          <!-- FAQ Item End -->

          <!-- FAQ Item Start -->
          <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
            <h2 class="accordion-header" id="heading3">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse3"
                aria-expanded="false"
                aria-controls="collapse3"
              >
                Are your products certified organic and Ayurvedic?
              </button>
            </h2>
            <div
              id="collapse3"
              class="accordion-collapse collapse"
              role="region"
              aria-labelledby="heading3"
              data-bs-parent="#accordion"
            >
              <div class="accordion-body">
                <p>
                  Yes, our herbal range includes certified organic products and
                  traditionally formulated Ayurvedic remedies. We clearly label
                  each product with its certifications and sourcing details, so
                  you can shop with complete confidence in the authenticity of
                  what you consume.
                </p>
              </div>
            </div>
          </div>
          <!-- FAQ Item End -->

          <!-- FAQ Item Start -->
          <div class="accordion-item wow fadeInUp" data-wow-delay="0.6s">
            <h2 class="accordion-header" id="heading4">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse4"
                aria-expanded="false"
                aria-controls="collapse4"
              >
                What payment methods do you accept?
              </button>
            </h2>
            <div
              id="collapse4"
              class="accordion-collapse collapse"
              role="region"
              aria-labelledby="heading4"
              data-bs-parent="#accordion"
            >
              <div class="accordion-body">
                <p>
                  We accept all major payment methods including UPI,
                  Credit/Debit Cards (Visa, Mastercard, RuPay), Net Banking, and
                  Cash on Delivery (COD) for orders across India. All online
                  transactions are secured with industry-standard encryption for
                  your safety.
                </p>
              </div>
            </div>
          </div>
          <!-- FAQ Item End -->

          <!-- FAQ Item Start -->
          <div class="accordion-item wow fadeInUp" data-wow-delay="0.8s">
            <h2 class="accordion-header" id="heading5">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse5"
                aria-expanded="false"
                aria-controls="collapse5"
              >
                Can I get personalized herbal recommendations?
              </button>
            </h2>
            <div
              id="collapse5"
              class="accordion-collapse collapse"
              role="region"
              aria-labelledby="heading5"
              data-bs-parent="#accordion"
            >
              <div class="accordion-body">
                <p>
                  Yes, we offer complimentary herbal consultation with our
                  in-house Ayurvedic experts. Whether you need help choosing the
                  right supplement or building a complete wellness routine,
                  simply reach out via our Contact page or WhatsApp, and we'll
                  guide you based on your unique health goals.
                </p>
              </div>
            </div>
          </div>
          <!-- FAQ Item End -->
        </div>
        <!-- FAQ Accordion End -->
      </div>
    </div>
  </div>
</div>
