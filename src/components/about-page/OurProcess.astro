---

<div class="our-process">
  <div class="container">
    <div class="row">
      <div class="col-lg-6">
        <!-- Our Process Content Start -->
        <div class="our-process-content">
          <!-- Section Title Start -->
          <div class="section-title">
            <span class="section-sub-title wow fadeInUp">Our Process</span>
            <h2 class="text-anime-style-3" data-cursor="-opaque">
              Purity In Every Step
            </h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s">
              Our approach focuses on delivering pure, authentic herbal products
              through ethical sourcing, rigorous testing, and customer-first
              wellness experiences.
            </p>
          </div>
          <!-- Section Title End -->

          <!-- Process Item List Start -->
          <div class="process-item-list">
            <!-- Process Item Start -->
            <div class="process-item wow fadeInUp">
              <div class="process-item-no">
                <h2>1</h2>
              </div>
              <div class="process-item-content">
                <h3>Ethical Botanical Sourcing</h3>
                <p>
                  Pure herbs and botanicals carefully sourced from certified
                  organic farms and traditional growers across India.
                </p>
              </div>
            </div>
            <!-- Process Item End -->

            <!-- Process Item Start -->
            <div class="process-item wow fadeInUp" data-wow-delay="0.2s">
              <div class="process-item-no">
                <h2>2</h2>
              </div>
              <div class="process-item-content">
                <h3>Lab-Tested Purity Assurance</h3>
                <p>
                  Every batch rigorously tested for purity, potency, and
                  authenticity to meet traditional Ayurvedic and modern safety
                  standards.
                </p>
              </div>
            </div>
            <!-- Process Item End -->

            <!-- Process Item Start -->
            <div class="process-item wow fadeInUp" data-wow-delay="0.4s">
              <div class="process-item-no">
                <h2>3</h2>
              </div>
              <div class="process-item-content">
                <h3>Wellness At Your Doorstep</h3>
                <p>
                  Swift and secure delivery of your herbal essentials,
                  preserving their natural potency from our hands to your home.
                </p>
              </div>
            </div>
            <!-- Process Item End -->
          </div>
          <!-- Process Item List End -->
        </div>
        <!-- Our Process Content End -->
      </div>

      <div class="col-lg-6">
        <!-- Process Image Box Start -->
        <div class="process-image-box wow fadeInUp" data-wow-delay="0.2s">
          <!-- Process Image Start -->
          <div class="process-image">
            <figure class="image-anime">
              <img
                src="/images/about-process-img.png"
                alt="Herbal preparation and sourcing process at Vaya-Leaf"
              />
            </figure>
          </div>
          <!-- Process Image End -->

          <!-- Process Quotes Box Start -->
          <div class="process-quotes-box">
            <div class="process-quotes-content">
              <p>
                "When diet is wrong, medicine is of no use. When diet is
                correct, medicine is of no need."
              </p>
              <p>— Ayurvedic Proverb</p>
            </div>
          </div>
          <!-- Process Quotes Box End -->
        </div>
        <!-- Process Image Box End -->
      </div>
    </div>
  </div>
</div>
