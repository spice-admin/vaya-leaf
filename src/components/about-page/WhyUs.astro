---

---

<div class="why-choose-us light-section">
  <div class="container">
    <div class="row section-row">
      <div class="col-lg-12">
        <!-- Section Title Start -->
        <div class="section-title section-title-center">
          <span class="section-sub-title wow fadeInUp">Why Choose Us</span>
          <h2 class="text-anime-style-3" data-cursor="-opaque">
            Pure Wellness You Can Trust
          </h2>
          <p class="wow fadeInUp" data-wow-delay="0.2s">
            We are committed to delivering pure herbal remedies, authentic
            wellness products, and reliable service that make your journey to
            natural health simple and rewarding.
          </p>
        </div>
        <!-- Section Title End -->
      </div>
    </div>

    <div class="row">
      <div class="col-xl-4 col-md-6">
        <!-- Why Choose Item Start -->
        <div class="why-choose-item wow fadeInUp">
          <div class="icon-box">
            <img
              src="/images/icon-why-choose-1.svg"
              alt="Pure natural herbs icon"
            />
          </div>
          <div class="why-choose-item-content">
            <h3>100% Pure & Natural</h3>
            <p>
              Carefully sourced herbs and botanicals selected from trusted
              organic farms and certified suppliers to ensure unmatched purity
              and potency in every product.
            </p>
          </div>
        </div>
        <!-- Why Choose Item End -->
      </div>

      <div class="col-xl-4 col-md-6">
        <!-- Why Choose Item Start -->
        <div class="why-choose-item wow fadeInUp" data-wow-delay="0.2s">
          <div class="icon-box">
            <img
              src="/images/icon-why-choose-2.svg"
              alt="Honest pricing icon"
            />
          </div>
          <div class="why-choose-item-content">
            <h3>Honest Everyday Pricing</h3>
            <p>
              Premium herbal wellness made accessible with transparent, fair
              pricing on every product — because natural health should never be
              a luxury for your family.
            </p>
          </div>
        </div>
        <!-- Why Choose Item End -->
      </div>

      <div class="col-xl-4 col-md-6">
        <!-- Why Choose Item Start -->
        <div class="why-choose-item wow fadeInUp" data-wow-delay="0.4s">
          <div class="icon-box">
            <img
              src="/images/icon-why-choose-3.svg"
              alt="Expert wellness guidance icon"
            />
          </div>
          <div class="why-choose-item-content">
            <h3>Expert Herbal Guidance</h3>
            <p>
              Our knowledgeable wellness team is here to guide you in choosing
              the right herbs and remedies tailored to your unique health needs
              and lifestyle.
            </p>
          </div>
        </div>
        <!-- Why Choose Item End -->
      </div>

      <div class="col-lg-12">
        <!-- Section Footer Text Start -->
        <div
          class="section-footer-text section-satisfy-img wow fadeInUp"
          data-wow-delay="0.6s"
        >
          <!-- Satisfy Client Images Start -->
          <div class="satisfy-client-images">
            <div class="satisfy-client-image">
              <figure class="image-anime">
                <img src="/images/author-1.jpg" alt="Happy wellness customer" />
              </figure>
            </div>
            <div class="satisfy-client-image add-more">
              <img
                src="/images/icon-phone-white.svg"
                alt="Contact us for consultation"
              />
            </div>
          </div>
          <!-- Satisfy Client Images End -->
          <p>
            Begin your natural wellness journey today. <a href="contact.html"
              >Get Free Herbal Consultation</a
            >
          </p>
        </div>
        <!-- Section Footer Text End -->
      </div>
    </div>
  </div>
</div>
